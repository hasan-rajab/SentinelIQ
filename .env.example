# SentinelIQ — local/development environment
# Copy to .env. Never commit real secrets.

# Backend
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SENTINELIQ_MODEL_DIR=ml/saved_models
SENTINELIQ_MODEL_CONFIG=configs/model_config.yaml
SENTINELIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence
POSTGRES_PASSWORD=change-me-for-any-shared-environment
# For non-Docker local execution, omit SENTINELIQ_DATABASE_URL to use SQLite.
# SENTINELIQ_DATABASE_URL=sqlite:///./sentineliq.db

# Streaming ingestion
SENTINELIQ_INGEST_API_KEY=change-me-for-any-shared-environment
SENTINELIQ_DEMO_INTERVAL_SECONDS=0.5

# Frontend (Next.js server proxies /api/* to the backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional LLM narration layer
GROQ_API_KEY=

# Federated learning
FEDERATED_SERVER_ADDRESS=0.0.0.0:8080
FEDERATED_ROUNDS=5
FEDERATED_MIN_CLIENTS=3

# Local Grafana only — change before exposing beyond localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-for-any-shared-environment
